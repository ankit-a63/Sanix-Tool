# SANIX TOOL - Production Environment Configuration Example
# Copy or rename this file to .env on your hosting server if environment variables are used.
# DO NOT commit real production passwords to git repositories.

APP_NAME="SANIX TOOL"
APP_ENV=production
APP_URL=https://your-domain.com/

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
